// ============================================================================
// GED Prep Platform — Prisma Schema (SQLite adapter)
// ============================================================================
// NOTE: Production uses PostgreSQL + MongoDB. This Prisma schema mirrors
// the PostgreSQL DDL from Loop 1, adapted for SQLite in the dev sandbox.
// - UUID → String @id @default(cuid())
// - ARRAY → String (JSON-encoded)
// - ENUM → String
// - JSONB → String (JSON)
// - lesson body_content → String (JSON, mirrors MongoDB LessonContent)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// USERS
// ---------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  displayName   String?
  role          String   @default("student")   // student, admin, instructor
  status        String   @default("active")    // active, suspended, deactivated
  avatarUrl     String?
  preferredLang String   @default("en")
  timezone      String   @default("UTC")
  targetGedDate String?                       // ISO date string
  scoreTarget   Int?                                 // GED Score Target: 145-200
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  quizAttempts      QuizAttempt[]
  spacedRepetitions SpacedRepetition[]
  lessonProgresses  LessonProgress[]
  aiConversations   AiConversation[]
  essaySubmissions  EssaySubmission[]
  readinessScores   ReadinessScore[]
  readinessHistory  ReadinessHistory[]
  dailyFlashcardQuizLogs DailyFlashcardQuizLog[]
}

// ---------------------------------------------------------------------------
// SUBJECTS (4 GED Subjects)
// ---------------------------------------------------------------------------
model Subject {
  id          String  @id @default(cuid())
  code        String  @unique                   // math, science, rla, ss
  title       String
  description String?
  iconUrl     String?
  colorHex    String  @default("#3B82F6")
  sortOrder   Int     @default(0)
  status      String  @default("draft")         // draft, published, archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules          Module[]
  questions        Question[]
  quizAttempts     QuizAttempt[]
  essayPrompts     EssayPrompt[]
  readinessScores  ReadinessScore[]
  readinessHistory ReadinessHistory[]
  flashcards       Flashcard[]
  topicCategories  TopicCategory[]
}

// ---------------------------------------------------------------------------
// MODULES
// ---------------------------------------------------------------------------
model Module {
  id             String   @id @default(cuid())
  subjectId      String
  title          String
  description    String?
  sortOrder      Int      @default(0)
  status         String   @default("draft")
  estimatedHours Float?                          // stored as float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([subjectId])
  @@index([subjectId, sortOrder])
}

// ---------------------------------------------------------------------------
// TOPICS
// ---------------------------------------------------------------------------
model Topic {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module  Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([moduleId])
  @@index([moduleId, sortOrder])
}

// ---------------------------------------------------------------------------
// TOPIC CATEGORIES (Exam-weighted curriculum categories)
// ---------------------------------------------------------------------------
model TopicCategory {
  id               String   @id @default(cuid())
  subjectId        String
  name             String                           // e.g. "Quantitative Problem Solving"
  nameTh           String                           // e.g. "การแก้ปัญหาเชิงปริมาณ"
  description      String?
  weightPercentage Int      @default(0)               // exam weight e.g. 45
  categoryType     String   @default("core")        // core, supplementary
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subject  Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([subjectId])
  @@index([subjectId, sortOrder])
}

// ---------------------------------------------------------------------------
// LESSONS
// ---------------------------------------------------------------------------
model Lesson {
  id             String   @id @default(cuid())
  topicId        String
  title          String
  slug           String   @unique
  contentType    String   @default("text")       // text, video, mixed
  bodyContent    String   @default("{}")         // JSON: mirrors MongoDB LessonContent blocks
  videoUrl       String?
  durationMinutes Int     @default(0)
  sortOrder      Int      @default(0)
  isPrerequisite Boolean  @default(false)
  status         String   @default("draft")
  lessonType     String   @default("core_topic")  // core_topic, supplementary_topic
  topicCategoryId String?                         // links to TopicCategory
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  topic           Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicCategory   TopicCategory?  @relation(fields: [topicCategoryId], references: [id], onDelete: SetNull)
  questions       Question[]
  lessonProgresses LessonProgress[]
  quizAttempts    QuizAttempt[]

  @@index([topicId])
  @@index([topicId, sortOrder])
  @@index([slug])
  @@index([topicCategoryId])
  @@index([lessonType])
}

// ---------------------------------------------------------------------------
// QUESTIONS
// ---------------------------------------------------------------------------
model Question {
  id            String   @id @default(cuid())
  lessonId      String?
  subjectId     String
  questionType  String                           // multiple_choice, multiple_select, fill_blank, drag_drop, short_answer
  difficulty    String   @default("medium")      // easy, medium, hard
  points        Int      @default(1)
  questionText  String?
  explanation   String?
  hintText      String?
  isActive      Boolean  @default(true)
  sourceTag     String?
  tags          String   @default("[]")          // JSON array of strings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  answers       Answer[]
  quizAnswers   QuizAttemptAnswer[]
  spacedRepetitions SpacedRepetition[]

  @@index([lessonId])
  @@index([subjectId])
  @@index([questionType])
  @@index([difficulty])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// ANSWERS
// ---------------------------------------------------------------------------
model Answer {
  id          String   @id @default(cuid())
  questionId  String
  content     String
  isCorrect   Boolean  @default(false)
  sortOrder   Int      @default(0)
  explanation String?
  createdAt   DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

// ---------------------------------------------------------------------------
// QUIZ ATTEMPTS
// ---------------------------------------------------------------------------
model QuizAttempt {
  id                String    @id @default(cuid())
  userId            String
  subjectId         String
  lessonId          String?
  quizType          String    @default("lesson_quiz")  // lesson_quiz, module_review, subject_test, ged_ready_full
  status            String    @default("in_progress")   // in_progress, completed, timed_out, abandoned
  totalQuestions    Int       @default(0)
  correctCount      Int       @default(0)
  scorePercent      Float     @default(0)
  timeSpentSecs     Int       @default(0)
  flaggedQuestionIds String   @default("[]")            // JSON array of question IDs
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  createdAt         DateTime  @default(now())

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lesson  Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  answers QuizAttemptAnswer[]

  @@index([userId])
  @@index([subjectId])
  @@index([userId, subjectId])
  @@index([status])
  @@index([quizType])
}

// ---------------------------------------------------------------------------
// QUIZ ATTEMPT ANSWERS
// ---------------------------------------------------------------------------
model QuizAttemptAnswer {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswerIds String  @default("[]")          // JSON array of answer IDs
  isCorrect        Boolean  @default(false)
  isFlagged        Boolean  @default(false)
  timeSpentSecs    Int      @default(0)
  answeredAt       DateTime @default(now())

  attempt  QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// ---------------------------------------------------------------------------
// SPACED REPETITION
// ---------------------------------------------------------------------------
model SpacedRepetition {
  id            String    @id @default(cuid())
  userId        String
  questionId    String
  srStatus      String    @default("new")          // new, learning, review, mastered
  easeFactor    Float     @default(2.50)
  intervalDays  Int       @default(0)
  repetitions   Int       @default(0)
  nextReviewAt  DateTime  @default(now())
  lastReviewAt  DateTime?
  lastRating    Int?                                 // 0=Again, 1=Hard, 2=Good, 3=Easy
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([nextReviewAt])
  @@index([userId, srStatus])
}

// ---------------------------------------------------------------------------
// LESSON PROGRESS
// ---------------------------------------------------------------------------
model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  isCompleted    Boolean   @default(false)
  completionPct  Int       @default(0)
  lastAccessed   DateTime  @default(now())
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([userId, isCompleted])
}

// ---------------------------------------------------------------------------
// AI CONVERSATIONS (Loop 1 — 002 migration)
// ---------------------------------------------------------------------------
model AiConversation {
  id              String   @id @default(cuid())
  userId          String
  contextType     String                             // quiz_explanation, lesson_clarification, general_help, essay_feedback
  contextRefId    String?                            // references quiz_attempt_answers / lessons / essay_submissions ID
  title           String?
  messageCount    Int      @default(0)
  isActive        Boolean  @default(true)
  aiProvider      String   @default("openai")
  aiModel         String   @default("gpt-4o")
  totalTokensIn   Int      @default(0)
  totalTokensOut  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]

  @@index([userId])
  @@index([contextType, contextRefId])
}

// ---------------------------------------------------------------------------
// AI MESSAGES
// ---------------------------------------------------------------------------
model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String                            // user, assistant, system
  content        String
  tokensUsed     Int      @default(0)
  latencyMs      Int?
  modelUsed      String?
  metadataJson   String   @default("{}")            // JSON
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// ESSAY PROMPTS
// ---------------------------------------------------------------------------
model EssayPrompt {
  id             String   @id @default(cuid())
  subjectId      String
  title          String
  passageText    String
  mongoPassageId String?
  promptText     String
  minWords       Int      @default(250)
  maxWords       Int      @default(500)
  timeLimitMins  Int      @default(45)
  difficulty     String   @default("medium")
  sourceTag      String?
  tags           String   @default("[]")            // JSON array
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subject  Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions EssaySubmission[]

  @@index([subjectId])
  @@index([isActive])
}

// ---------------------------------------------------------------------------
// ESSAY SUBMISSIONS
// ---------------------------------------------------------------------------
model EssaySubmission {
  id                String    @id @default(cuid())
  userId            String
  promptId          String
  mongoEssayId      String                            // MongoDB ref (hex string)
  status            String    @default("draft")       // draft, submitted, grading, graded, revision_requested
  wordCount         Int       @default(0)
  timeSpentSecs     Int       @default(0)
  startedAt         DateTime  @default(now())
  submittedAt       DateTime?
  gradedAt          DateTime?
  totalScore        Int?                                 // 0-100
  gedEquivalent     Int?                                 // 100-200
  aiProvider        String?
  aiModel           String?
  gradingTokensUsed Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt   EssayPrompt          @relation(fields: [promptId], references: [id], onDelete: Cascade)
  grading  EssayGradingDetail[]

  @@index([userId])
  @@index([promptId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// ESSAY GRADING DETAILS
// ---------------------------------------------------------------------------
model EssayGradingDetail {
  id               String   @id @default(cuid())
  submissionId     String
  dimension        String                            // claim, evidence, organization, language, reasoning
  score            Int                                 // 0-4
  maxScore         Int      @default(4)
  feedback         String   @default("")
  strengths        String   @default("[]")            // JSON array
  improvements     String   @default("[]")            // JSON array
  mongoFeedbackId  String?
  createdAt        DateTime @default(now())

  submission EssaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, dimension])
  @@index([submissionId])
}

// ---------------------------------------------------------------------------
// FLASHCARDS (Vocabulary active recall)
// ---------------------------------------------------------------------------
model Flashcard {
  id          String   @id @default(cuid())
  subjectId   String
  term        String                           // English term e.g. "Slope (m)"
  translation String                           // Thai translation e.g. "ความชันของเส้นตรง"
  pronunciation String  @default("")          // Thai pronunciation subtitle e.g. "ความ-ชัน คอน เส้น-ตรง"
  meaning     String                           // Detailed explanation in Thai
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject       Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  dailyQuizLogs DailyFlashcardQuizLog[]

  @@index([subjectId])
  @@index([subjectId, sortOrder])
}

// ---------------------------------------------------------------------------
// DAILY FLASHCARD QUIZ LOG
// ---------------------------------------------------------------------------
model DailyFlashcardQuizLog {
  id          String   @id @default(cuid())
  userId      String
  flashcardId String
  answeredAt  DateTime @default(now())
  isCorrect   Boolean
  userAnswer  String                           // what the user typed

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, answeredAt])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// READINESS SCORES
// ---------------------------------------------------------------------------
model ReadinessScore {
  id                   String   @id @default(cuid())
  userId               String   @unique                 // One record per user in this simplified version
  subjectId            String
  predictedGedScore    Int                              // 100-200
  confidenceLevel      String                           // not_ready, approaching, likely_pass, strong_pass
  passProbability      Float                            // 0-100
  quizScoreFactor      Float    @default(0)
  completionFactor     Float    @default(0)
  masteryFactor        Float    @default(0)
  recencyFactor        Float    @default(0)
  consistencyFactor    Float    @default(0)
  essayFactor          Float    @default(0)
  inputSnapshot        String   @default("{}")         // JSON
  bestGedReadyScore    Float?
  bestGedReadyDate     DateTime?
  calculatedAt         DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  history ReadinessHistory[]

  @@unique([userId, subjectId])
}

// ---------------------------------------------------------------------------
// READINESS HISTORY
// ---------------------------------------------------------------------------
model ReadinessHistory {
  id                 String   @id @default(cuid())
  userId             String
  subjectId          String
  predictedGedScore  Int
  confidenceLevel    String
  passProbability    Float
  triggerEvent       String   @default("auto")      // auto, manual
  inputSnapshot      String   @default("{}")         // JSON
  calculatedAt       DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  score   ReadinessScore @relation(fields: [userId, subjectId], references: [userId, subjectId], onDelete: Cascade)

  @@index([userId, subjectId, calculatedAt])
}